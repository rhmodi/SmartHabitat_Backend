    </owl:Class>
    


    <!-- http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#AllNarcotics -->

    <owl:Class rdf:about="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#AllNarcotics">
