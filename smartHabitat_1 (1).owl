        <owl:disjointWith rdf:resource="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#Arson"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#ChildPornography"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#SexOffense"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#Shooting"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#AllHumanTrafficking -->

    <owl:Class rdf:about="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#AllHumanTrafficking">
