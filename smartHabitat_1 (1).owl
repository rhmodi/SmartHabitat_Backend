    <!-- http://geovocab.org/spatial#Feature -->

    <rdf:Description rdf:about="http://geovocab.org/spatial#Feature">
        <owl:equivalentClass rdf:resource="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#GeographicType"/>
    </rdf:Description>
    


    <!-- http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#AllAssault -->

    <owl:Class rdf:about="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#AllAssault">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#Critical"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#AllHomicide"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#SexOffense"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#AllBattery -->

    <owl:Class rdf:about="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#AllBattery">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#Critical"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#AllCriminalSexualAssualt"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#AllHomicide"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#AllHumanTrafficking"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#Arson"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#ChildPornography"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#SexOffense"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#Shooting"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#AllBurglary -->

    <owl:Class rdf:about="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#AllBurglary">
        <owl:equivalentClass rdf:resource="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#AllRobbery"/>
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#Serious"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#AllCriminalSexualAssualt -->

    <owl:Class rdf:about="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#AllCriminalSexualAssualt">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#Critical"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#AllHomicide"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#SexOffense"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#AllHomicide -->

