    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#hasCatergory -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#hasCatergory">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#Crime"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#CrimeCategory"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#hasCrime -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#hasCrime">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#Community"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#Crime"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#isInCity -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#isInCity">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#isLocatedIn"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#Community"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#City"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#isInCounty -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#isInCounty">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#isLocatedIn"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#City"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#County"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#isLocatedIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#isLocatedIn">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#GeographicType"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/team4/ontologies/2024/10/smartHabitat#GeographicType"/>
    </owl:ObjectProperty>
    


